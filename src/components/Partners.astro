---
/**
 * Partnerji — minimalističen vodoraven trak na vrhu noge strani (vstavljen v Footer.astro).
 * »Omogoča:« JRM (izrazitejši) + »V sodelovanju z:« uradni vektorski logotipi (enotno sivi).
 * Prikažejo se samo vnosi z verified: true (content.ts). Na telefonu počasen marquee,
 * pri zmanjšanem gibanju navaden vodoraven drsnik.
 */
import { partners } from '../data/content';

const logos = partners.collaborators.filter((c) => c.verified);
const trustedLogos = partners.trusted.filter((c) => c.verified);
// Enaka optična velikost: vsak logotip dobi približno enako ploščino (višina = √(A / razmerje))
const AREA = 3300;
const sized = logos.map((l) => {
  const h = Math.sqrt(AREA / l.ratio);
  return { ...l, h: Math.round(h * 10) / 10, w: Math.round(h * l.ratio) };
});
const sizedTrusted = trustedLogos.map((l) => {
  const h = Math.sqrt(AREA / l.ratio);
  return { ...l, h: Math.round(h * 10) / 10, w: Math.round(h * l.ratio) };
});
---

<section id="partnerji" class="partners" aria-label={partners.label}>
  <div class="strip" data-reveal>
    <!-- Vrstica 1: Omogoča JRM -->
    <div class="strip__row strip__row--lead">
      <p class="strip__label">{partners.poweredBy}</p>
      <img class="jrm" src="/images/partners/jrm.png" alt="JRM Finančne storitve" width="186" height="81" decoding="async" />
    </div>

    <!-- Vrstica 2: V sodelovanju z -->
    {logos.length > 0 && (
      <div class="strip__row strip__row--partners">
        <p class="strip__label" id="collab-label">{partners.collaboratorsLabel}</p>
        <div class="marquee" data-marquee>
          <ul class="marquee__track" aria-labelledby="collab-label">
            {sized.map((l) => (
              <li class="plogo" style={`--h:${l.h}px`}>
                <img src={l.src} alt={l.name} width={l.w} height={l.h} loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
              </li>
            ))}
            {sized.map((l) => (
              <li class="plogo plogo--clone" style={`--h:${l.h}px`} aria-hidden="true">
                <img src={l.src} alt="" width={l.w} height={l.h} loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Vrstica 3: Zaupajo nam -->
    <div class="strip__row strip__row--trusted">
      <p class="strip__label" id="trusted-label">{partners.trustedByLabel}</p>
      {sizedTrusted.length > 0 ? (
        <div class="marquee" data-marquee>
          <ul class="marquee__track" aria-labelledby="trusted-label">
            {sizedTrusted.map((l) => (
              <li class="plogo" style={`--h:${l.h}px`}>
                <img src={l.src} alt={l.name} width={l.w} height={l.h} loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
              </li>
            ))}
            {sizedTrusted.map((l) => (
              <li class="plogo plogo--clone" style={`--h:${l.h}px`} aria-hidden="true">
                <img src={l.src} alt="" width={l.w} height={l.h} loading="lazy" decoding="async" onerror="this.closest('li').style.display='none'" />
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <span class="strip__placeholder">Logotipi kmalu</span>
      )}
    </div>
  </div>
</section>

<style>
  /* Prvi del skupne noge strani (Footer.astro) — nad kontaktom */
  .partners { margin-bottom: var(--space-8); scroll-margin-top: 88px; }

  /* Trak: tanke ločilne črte, brez kartic in senc */
  .strip { border-top: none; }

  /* Vsaka vrstica: oznaka levo (fiksna širina), vsebina desno */
  .strip__row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    align-items: center;
    column-gap: 32px;
    padding-block: 28px;
  }
  .strip__row + .strip__row { border-top: none; }

  /* Vrstica z logootipi: oznaka nad, logotipi čez vso širino */
  .strip__row--partners {
    grid-template-columns: 1fr;
    row-gap: 20px;
  }

  .strip__label {
    font-size: var(--fs-micro);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .jrm {
    display: block;
    height: 60px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.7;
  }
  @media (max-width: 900px) { .jrm { height: 50px; } }

  /* Logotipi: enotno sivi, ob prehodu polni ton */
  .marquee { min-width: 0; }
  .marquee__track {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: clamp(36px, 4.2vw, 64px);
    row-gap: 28px;
  }
  .plogo { flex: none; display: grid; place-items: center; height: 52px; }
  .plogo img {
    display: block;
    height: calc(var(--h) * var(--k, 1));
    width: auto;
    filter: brightness(0) invert(1);
    mix-blend-mode: normal;
    opacity: 0.65;
    transition: opacity var(--t-fast) var(--ease);
  }
  .plogo:hover img { opacity: 1; }
  .plogo--clone { display: none; }

  .strip__placeholder {
    font-size: var(--fs-micro);
    color: rgb(255 255 255 / 0.3);
    letter-spacing: 0.08em;
  }

  /* Telefon in tablica: oznaka nad vsebino, marquee */
  @media (max-width: 900px) {
    .strip__row { grid-template-columns: 1fr; row-gap: 16px; padding-block: 24px; }
    .marquee {
      overflow: hidden;
      margin-inline: calc(var(--gutter) * -1);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    }
    .marquee__track {
      flex-wrap: nowrap;
      width: max-content;
      column-gap: 0;
      animation: marquee 38s linear infinite;
    }
    .plogo { --k: 0.8; padding-inline: 22px; height: 44px; }
    .plogo--clone { display: grid; }
    .marquee:hover .marquee__track,
    .marquee:focus-within .marquee__track { animation-play-state: paused; }
  }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* Zmanjšano gibanje: brez animacije, ročni vodoravni drsnik s pripenjanjem */
  @media (max-width: 900px) and (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-mask-image: none;
      mask-image: none;
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .marquee::-webkit-scrollbar { display: none; }
    .marquee__track { animation: none; }
    .plogo { scroll-snap-align: start; }
    .plogo--clone { display: none; }
  }
</style>
