---
/**
 * Monogram AC: črni serifni črki z zlatim trakom (public/logo-ac.png, prosojno ozadje).
 * Izrezano iz izvirne slike na črni podlagi; `size` je višina v px.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const width = Math.round(size * (231 / 160));
---

<img
  class:list={['logo', className]}
  src="/logo-ac.png"
  width={width}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
/>
