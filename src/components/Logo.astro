---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const width = Math.round(size * 2); // 1774 × 887 → 2:1
---

<img
  class:list={['logo', className]}
  src="/logo-ac.png"
  width={width}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
  style="mix-blend-mode: multiply;"
/>
