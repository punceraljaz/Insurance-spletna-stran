---
/**
 * Začetek poti: kratek naslov in takoj pod njim pet področij.
 * Brez uvodnih odstavkov — rezervacija je v navigaciji in v vsakem odprtem področju.
 */
import { individualsPage, businessPage, individualCategories, businessCategories, audiences, type Audience } from '../data/content';
import CategoryExplorer from './CategoryExplorer.astro';

interface Props { audience: Audience }
const { audience } = Astro.props;
const isBiz = audience === 'podjetja';
const page = isBiz ? businessPage : individualsPage;
const categories = isBiz ? businessCategories : individualCategories;
---

<section id="zavarovanja" class="ahero shell" data-chapter={audiences[audience].chapter} aria-labelledby="ahero-title">
  <header class="ahero__head" data-reveal>
    <h1 id="ahero-title" class="ahero__title">
      <span class="ahero__line">{page.title}</span><span class="ahero__line"><em class="serif">{page.titleAccent}</em></span>
    </h1>
  </header>
  <div data-reveal style="--i:1">
    <CategoryExplorer categories={categories} />
  </div>
</section>

<style>
  .ahero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    /* Kartice na sredini zaslona: padding naraste dokler ne center-ira vsebine */
    padding-top: max(clamp(80px, 9vh, 120px), calc(50svh - 230px));
    padding-bottom: clamp(48px, 6vh, 80px);
    scroll-margin-top: 88px;
    transition: padding-top 700ms var(--ease);
  }
  /* Ko je katera koli kartica odprta → vsebina zdrsne navzgor */
  .ahero:has([data-cats]:not([data-active='-1'])) {
    padding-top: clamp(80px, 9vh, 120px);
  }
  .ahero__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(72px, 10vh, 120px);
    /* Prebije iz shell paddinga — naslov od roba do roba */
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .ahero__title {
    font-size: clamp(1rem, 4vw, 2.25rem);
    font-weight: var(--w-heading);
    line-height: 1.2;
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    max-width: none;
    text-align: center;
  }
  .ahero__line { display: block; white-space: nowrap; }
  @media (max-width: 640px) {
    .ahero { min-height: 0; padding-top: 40px; padding-bottom: var(--space-8); transition: none; }
    .ahero__title { font-size: clamp(0.9375rem, 4.5vw, 1.5rem); }
    .ahero__line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  }
</style>
