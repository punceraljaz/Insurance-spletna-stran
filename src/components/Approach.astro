---
/**
 * Posamezniki: zavarovalno posredništvo kot način dela pri vseh področjih (ni šesta kategorija).
 * Minimalistična postavitev: naslov in štiri oštevilčene točke na sredini, tanka pisava, brez slike.
 * Klik na točko razpre kratek opis (scripts/site.ts → initToggles, atributi data-toggle / aria-controls).
 */
import { individualApproach as a } from '../data/content';
---

<section id="nacin-dela" class="chapter shell approach" data-chapter="warm" aria-labelledby="appr-title">
  <div class="approach__grid">
    <div class="approach__text">
      <h2 id="appr-title" class="approach__title" data-reveal>{a.label}</h2>

      <ol class="approach__list">
        {a.points.map((p, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <li class="approach__item" data-expandable data-reveal style={`--i:${i + 1}`}>
              <h3 class="approach__h">
                <button class="approach__btn" type="button" aria-expanded="false" aria-controls={`nacin-${n}`} data-toggle>
                  <span class="approach__n" aria-hidden="true">{n}</span>
                  <span class="approach__k">{p.k}</span>
                  <span class="approach__mark" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="approach__panel" id={`nacin-${n}`} data-open="false">
                <div class="approach__panel-in">
                  <p class="approach__v">{p.v}</p>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .approach { padding-block: clamp(80px, 9vw, 128px); }
  .approach__grid { max-width: 560px; margin-inline: auto; }

  /* Vse na sredini, tanka pisava, brez slike */
  .approach__text { display: grid; justify-items: center; text-align: center; }
  .approach__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.22em;
    color: var(--ink-black);
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  .approach__list { list-style: none; padding: 0; display: grid; gap: clamp(8px, 1.2vw, 14px); justify-items: center; }
  .approach__item { display: grid; justify-items: center; }
  .approach__h { font: inherit; }
  .approach__btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-black);
    cursor: pointer;
  }
  .approach__n { font-size: 0.6875rem; font-weight: 300; letter-spacing: 0.08em; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .approach__k {
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) 50% 100% / 0 1px no-repeat;
    padding-bottom: 3px;
    transition: background-size 420ms var(--ease);
  }
  .approach__btn:hover .approach__k,
  .approach__item.is-open .approach__k { background-size: 100% 1px; }
  .approach__btn:focus-visible { outline: 2px solid var(--ink-black); outline-offset: 6px; border-radius: 4px; }

  /* Drobna tanka oznaka: plus, ki se ob odprtju zapre v minus */
  .approach__mark { position: relative; width: 8px; height: 8px; flex: none; color: var(--ink-soft); }
  .approach__mark::before, .approach__mark::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 8px; height: 1px; background: currentColor;
    transition: transform 360ms var(--ease);
  }
  .approach__mark::after { transform: rotate(90deg); }
  .approach__item.is-open .approach__mark::after { transform: rotate(0deg); }

  /* Razpiranje opisa: gladko po višini, skrito tudi bralnikom, ko je zaprto */
  .approach__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 420ms var(--ease), visibility 0s linear 420ms;
  }
  .approach__panel[data-open='true'] {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 420ms var(--ease), visibility 0s;
  }
  .approach__panel-in { overflow: hidden; }
  .approach__v {
    max-width: 34ch;
    margin-inline: auto;
    padding: 2px 0 10px;
    font-weight: 300;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 320ms var(--ease), transform 420ms var(--ease);
  }
  .approach__panel[data-open='true'] .approach__v { opacity: 1; transform: none; transition-delay: 80ms; }

  @media (prefers-reduced-motion: reduce) {
    .approach__panel, .approach__panel[data-open='true'], .approach__v, .approach__k, .approach__mark::after { transition: none; }
  }
</style>
