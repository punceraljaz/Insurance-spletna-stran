---
/**
 * Začasni generični znak: dva prepletena tanka obroča (partnerstvo, zaupanje).
 * Enobarven obris v barvi besedila (currentColor). Zamenjaj, ko bo uradni logotip.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="16" r="9.5" />
  <circle cx="20" cy="16" r="9.5" />
</svg>
