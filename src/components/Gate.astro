---
/**
 * NASLOVNICA — uredniška »platnica«: ena atmosfera, ena izjava, ena identiteta, dve izbiri.
 *
 * Ozadje je animiran gradient (WebGL, glej scripts/hero-gradient.ts) čez cel zaslon.
 * Pod platnom je statična slika istega gradienta — vidna takoj ob 0,00 s, brez WebGL
 * in ob prekinjenem kontekstu.
 *
 * Izbiri sta navadni povezavi (/posamezniki/, /podjetja/): delujeta brez JavaScripta,
 * z zaznamki in z gumboma Nazaj/Naprej. Uvodna koreografija je samo CSS; vsebina je
 * v DOM-u in uporabna od prvega trenutka.
 */
import { gate, audiences, site, type Audience } from '../data/content';
import Logo from './Logo.astro';
const order: Audience[] = ['posamezniki', 'podjetja'];
---

<script is:inline>
  // Uvod se predvaja celoten samo ob prvem obisku v zavihku; ob vrnitvi je kratek.
  try {
    if (sessionStorage.getItem('naslovnica-uvod')) document.documentElement.classList.add('intro-seen');
    sessionStorage.setItem('naslovnica-uvod', '1');
  } catch (e) {}
</script>

<div class="sky" aria-hidden="true">
  <canvas class="sky__canvas" data-hero-gradient></canvas>
  <div class="sky__light"></div>
</div>

<div class="cover" data-cover>
  <header class="cover__top">
    <p class="wordmark intro" style="--d:300ms; --dur:650ms; --y:8px">
      <Logo size={34} class="wordmark__logo" />
      <span class="wordmark__name">{site.brandName}</span>
      <span class="wordmark__sub">{site.brandSub}</span>
    </p>
  </header>

  <main id="vsebina" class="cover__main" tabindex="-1">
    <div class="cover__statement">
      <h1 class="cover__title">
        <span class="cover__line intro" style="--d:800ms; --dur:900ms; --y:16px">{gate.statement[0]}</span>{' '}
        <span class="cover__line intro" style="--d:940ms; --dur:900ms; --y:16px">{gate.statement[1]}</span>
      </h1>
      <p class="cover__support intro" style="--d:1500ms; --dur:700ms; --y:8px">{gate.support}</p>
    </div>

    <nav class="cover__choices" aria-label={gate.choicesLabel}>
      <ul>
        {order.map((a, i) => (
          <li class="intro" style={`--d:${2000 + i * 130}ms; --dur:700ms; --y:10px`}>
            <a class="pill" href={audiences[a].href} data-choice={a}>
              <span>{gate.choices[a]}</span>
              <span class="pill__knob" aria-hidden="true">
                <svg class="pill__arrow" viewBox="0 0 20 20" focusable="false">
                  <path d="M4 10h11.5M11 5.5 15.5 10 11 14.5" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>

</div>

<style>

  /* ---------- Atmosfera: cel zaslon, brez okvirja ---------- */
  /* Safari na iPhonu pas pod uro in spodnjo vrstico pobarva z ENO barvo (ozadje fiksne plasti
     oziroma strani) — slike tja ne riše. Zato gradient na vrhu in dnu mehko preide natanko v to
     barvo (--sky-edge), da ni vidnega prehoda; vse skupaj deluje kot ena, večja slika. */
  :global(html:has(.sky)) { background: #b4c5d1; }
  .sky {
    --sky-edge: #b4c5d1;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100lvh;
    min-height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--sky-edge) url('/atmosfera/naslovnica.webp') center / 125% auto no-repeat;
  }
  /* Mehek prehod v barvo roba — zgoraj in spodaj */
  .sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
      var(--sky-edge) 0%,
      rgb(180 197 209 / 0.85) calc(env(safe-area-inset-top) + 2%),
      rgb(180 197 209 / 0) calc(env(safe-area-inset-top) + 16%),
      rgb(180 197 209 / 0) 84%,
      rgb(180 197 209 / 0.85) 96%,
      var(--sky-edge) 100%);
  }
  @media (orientation: portrait) {
    .sky { background-image: url('/atmosfera/naslovnica-pokoncna.webp'); background-size: auto 125%; }
    .sky .sky__light {
      background:
        radial-gradient(ellipse 90% 40% at 50% 46%, rgb(246 248 247 / 0.62) 0%, rgb(246 248 247 / 0.34) 50%, rgb(246 248 247 / 0) 100%),
        linear-gradient(to bottom, rgb(244 246 246 / 0.55) 0%, rgb(244 246 246 / 0.2) 12%, rgb(244 246 246 / 0) 22%, rgb(244 246 246 / 0) 66%, rgb(244 246 246 / 0.5) 100%);
    }
  }
  .sky__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    /* Povečano: gradient je večji, robovi so izven zaslona */
    transform: scale(1.25);
    transition: opacity 900ms var(--ease);
  }
  .sky__canvas:global(.is-live) { opacity: 1; }

  /* Razpršena svetloba za berljivost: osvetli območje besedila, ne riše oblik */
  .sky__light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 44% at 50% 47%, rgb(246 248 247 / 0.62) 0%, rgb(246 248 247 / 0.34) 48%, rgb(246 248 247 / 0) 100%),
      linear-gradient(to bottom, rgb(244 246 246 / 0.55) 0%, rgb(244 246 246 / 0.2) 14%, rgb(244 246 246 / 0) 26%, rgb(244 246 246 / 0) 74%, rgb(244 246 246 / 0.5) 100%);
  }

  /* ---------- Kompozicija platnice ---------- */
  .cover {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    text-align: center;
  }
  .cover__top {
    display: grid;
    justify-items: center;
    padding-top: clamp(28px, 6.5vh, 72px);
  }
  .cover__main {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    padding-block: clamp(24px, 4vh, 48px) clamp(36px, 8vh, 96px);
  }
  .cover__main:focus { outline: none; }

  /* Identiteta: tanek generični znak, ime znamke, dejavnost */
  .wordmark {
    display: grid;
    justify-items: center;
    gap: 6px;
    color: var(--ink);
  }
  .wordmark__logo { margin-bottom: 8px; }
  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 300;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: 0.32em;
    margin-inline-end: -0.32em; /* uravnoteži razmik za zadnjo črko */
  }
  .wordmark__sub {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Izjava: uredniški serif, umirjena teža, oblikovan prelom */
  .cover__statement {
    align-self: center;
    display: grid;
    justify-items: center;
    margin-top: -2vh;
  }
  .cover__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, min(0.5rem + 2.2vw, 6vh), 2.75rem);
    font-weight: var(--w-heading);
    text-transform: uppercase;
    line-height: 1.35;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  /* Ena vrstica na širših zaslonih; na telefonu se razdeli na dve */
  .cover__title { white-space: nowrap; }
  .cover__line { display: inline-block; }
  .cover__support {
    margin-top: clamp(20px, 3.2vh, 32px);
    max-width: 40ch;
    font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: balance;
  }

  /* ---------- Dve izbiri: prosojni matirani stekleni nalepki ---------- */
  .cover__choices ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 18px;
  }
  .cover__choices li { position: relative; }
  /* Ploska, meglena steklena nalepka nad gradientom: ena polprosojna barva
     (brez prelivov), močna zameglitev ozadja, komaj viden rob, brez reliefa, sijaja in zrnja. */
  .pill {
    --pill-fill: rgb(232 238 242 / 0.26);
    --pill-blur: 22px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 300px;
    min-height: 76px;
    padding: 0 26px 0 30px;
    border-radius: 22px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background-color: var(--pill-fill);
    -webkit-backdrop-filter: blur(var(--pill-blur)) saturate(0.9);
    backdrop-filter: blur(var(--pill-blur)) saturate(0.9);
    color: #34383c;
    font-size: 1.0625rem;
    font-weight: 450;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      opacity 320ms var(--ease),
      background-color 320ms var(--ease),
      border-color 320ms var(--ease),
      backdrop-filter 320ms var(--ease),
      -webkit-backdrop-filter 320ms var(--ease);
  }
  .pill:hover {
    --pill-fill: rgb(238 243 246 / 0.36);
    --pill-blur: 28px;
    border-color: rgb(255 255 255 / 0.28);
  }
  .pill:active { --pill-fill: rgb(214 223 230 / 0.34); }
  .pill:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  /* Puščica sama na ploskem steklu, brez kroga */
  .pill__knob { flex: none; display: grid; place-items: center; }
  .pill__arrow {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 260ms var(--ease);
  }
  .pill:hover .pill__arrow { transform: translateX(3px); }

  /* ---------- Uvodna koreografija ----------
     0,30 s identiteta · 0,80 s izjava (dve vrstici) · 1,50 s stavek · 2,00 s izbiri · 2,60 s mir.
     Samo prosojnost in majhen premik; nič ne blokira klikov ali tipkovnice. */
  @media (prefers-reduced-motion: no-preference) {
    .intro { animation: cover-rise var(--dur, 700ms) cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) both; }
    :global(html.intro-seen) .intro { --d: 0ms !important; --dur: 450ms !important; }
    /* Fokus ali dotik med uvodom takoj pokaže vse */
    .cover:global(.intro-skip) .intro,
    .cover__choices:focus-within .intro { animation: none; }
  }
  @keyframes cover-rise {
    from { opacity: 0; transform: translateY(var(--y, 8px)); }
  }

  /* ---------- Odhod: izbira potrdi klik, izjava se umakne, atmosfera teče naprej ---------- */
  .cover__top, .cover__statement {
    transition: opacity 320ms var(--ease), transform 320ms var(--ease);
  }
  .cover:global(.is-leaving) .cover__top,
  .cover:global(.is-leaving) .cover__statement { opacity: 0; transform: translateY(-10px); }
  .cover:global(.is-leaving) .pill:not(:global(.is-chosen)) { opacity: 0; }
  .pill:global(.is-chosen) {
    --pill-fill: rgb(240 245 248 / 0.42);
  }

  /* ---------- Mobilno ---------- */
  @media (max-width: 640px) {
    .cover__top { padding-top: 28px; }
    .wordmark__name { font-size: 1.1875rem; }
    .wordmark__sub { font-size: 0.8125rem; letter-spacing: 0.18em; }
    .cover__title { font-size: clamp(1.5rem, 7vw, 2rem); white-space: normal; }
    .cover__line { display: block; }
    .cover__statement { margin-top: 0; }
    .cover__main { padding-bottom: 32px; }
    .cover__choices { width: 100%; max-width: 360px; }
    .cover__choices ul { flex-direction: column; align-items: stretch; gap: 12px; }
    .pill { width: 100%; min-width: 0; min-height: 72px; border-radius: 20px; }
  }
</style>
