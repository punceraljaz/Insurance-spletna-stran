# Sprejem obrazcev /api/povprasevanje — kopiraj v .env (ne objavljaj!) ali nastavi pri gostitelju.
# Povpraševanja in priložene police se pošljejo kot e-sporočilo s priponkami na INQUIRY_TO.
SMTP_HOST=smtp.example.si
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Pošiljatelj mora biti dovoljen na SMTP strežniku (SPF/DKIM domene)
INQUIRY_FROM="Spletna stran <obrazci@example.si>"
INQUIRY_TO=svetovalec@example.si
