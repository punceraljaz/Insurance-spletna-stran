---
/**
 * Pošlji polico v pregled — velika vstopna sekcija.
 * Privzeto: samo naslov + gumb. Ob kliku se forma razširi z animacijo.
 */
import { policyReview as r, type Audience } from '../data/content';
import '@fontsource/krona-one/latin-400.css';
import '@fontsource/krona-one/latin-ext-400.css';

interface Props { audience: Audience }
const { audience } = Astro.props;
const isBiz = audience === 'podjetja';
---

<section id="pregled" class="intake" data-chapter="day" aria-labelledby="intake-title">
  <div class="intake__stage" data-intake-stage>
    <div class="intake__intro">
      <h2 id="intake-title" class="intake__title" data-reveal style="--i:1">{r.title}</h2>
      <div class="intake__open-wrap">
      <button class="intake__open" type="button" aria-expanded="false" aria-controls="policy-form" data-intake-open>
        <span>Začni pregled</span>
        <svg class="intake__open-arrow" viewBox="0 0 20 20" focusable="false" aria-hidden="true">
          <path d="M10 4v11.5M5 11l5 4.5 5-4.5" />
        </svg>
      </button>
      </div>
    </div>

    <div class="intake__collapse" id="policy-form-wrap">
      <div class="intake__collapse-inner">
      <button class="intake__close" type="button" aria-label="Zapri obrazec" data-intake-close>
        <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
          <path d="M10 15V4.5M5 9l5-4.5 5 4.5" />
        </svg>
        <span>Zapri</span>
      </button>
      <form class="intake__card" id="policy-form" novalidate data-policy-form aria-labelledby="intake-card-title">
        <h3 id="intake-card-title" class="intake__card-title">{r.cardTitle}</h3>

        <div class="intake__fields">
          <div class="field">
            <label class="field__label" for="policy-name">Ime in priimek</label>
            <input class="input" id="policy-name" name="name" type="text" autocomplete="name" required aria-describedby="policy-name-error" />
            <p class="field__error" id="policy-name-error" data-error-for="name" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="policy-contact">E-pošta ali telefon</label>
            <input class="input" id="policy-contact" name="contact" type="text" autocomplete="email" required aria-describedby="policy-contact-error" />
            <p class="field__error" id="policy-contact-error" data-error-for="contact" hidden></p>
          </div>
          {isBiz && (
            <div class="field">
              <label class="field__label" for="policy-company">Podjetje <span class="optional">(neobvezno)</span></label>
              <input class="input" id="policy-company" name="company" type="text" autocomplete="organization" />
            </div>
          )}
          <div class="field">
            <label class="field__label" for="policy-note">Kaj želite preveriti <span class="optional">(neobvezno)</span></label>
            <textarea class="input" id="policy-note" name="note" rows="2"></textarea>
          </div>
        </div>

        <div class="field">
          <div class="drop" data-drop>
            <input class="sr-only" type="file" id="policy-files" name="files" multiple accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="drop-help files-error" data-file-input />
            <label class="intake__drop" for="policy-files">
              <span class="intake__drop-mark" aria-hidden="true"></span>
              <span class="intake__drop-title">{r.dropTitle}</span>
              <span class="intake__drop-text">Povlecite datoteko sem ali <u>izberite iz naprave</u></span>
            </label>
          </div>
          <p class="field__help" id="drop-help">PDF, JPG ali PNG · do 10 MB · največ 5 datotek</p>
          <p class="field__error" id="files-error" data-error-for="files" hidden></p>
          <ul class="file-list" data-file-list aria-label="Izbrane datoteke"></ul>
          <p class="sr-only" aria-live="polite" data-file-status></p>
        </div>

        <div class="field">
          <label class="check">
            <input type="checkbox" name="consent" required aria-describedby="policy-consent-error" />
            <span class="check__box" aria-hidden="true"></span>
            <span>Strinjam se z obdelavo podatkov za namen pregleda police.</span>
          </label>
          <p class="field__error" id="policy-consent-error" data-error-for="consent" hidden></p>
        </div>

        <div class="intake__foot">
          <button class="intake__submit" type="submit">
            <span>{r.submit}</span>
            <span class="intake__submit-line" aria-hidden="true"></span>
          </button>
          <p class="intake__helper">{r.helper}</p>
        </div>

        <div class="result" data-policy-result tabindex="-1" hidden></div>
      </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-intake-open]').forEach(btn => {
    btn.addEventListener('click', () => {
      const stage = btn.closest<HTMLElement>('[data-intake-stage]');
      if (!stage) return;
      stage.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      const first = stage.querySelector<HTMLElement>('.input');
      if (first) setTimeout(() => first.focus(), 420);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-intake-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      const stage = btn.closest<HTMLElement>('[data-intake-stage]');
      if (!stage) return;
      stage.classList.remove('is-open');
      const openBtn = stage.querySelector<HTMLButtonElement>('[data-intake-open]');
      if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .intake {
    padding-block: clamp(100px, 18vw, 220px);
    scroll-margin-top: 88px;
    position: relative;
    background: url('/intake-bg.png') center / cover no-repeat fixed;
  }

  /* ---------- Steklena kartica ---------- */
  .intake__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.5vw, 32px);
    padding: clamp(28px, 3.5vw, 48px);
    max-width: 900px;
    margin-inline: auto;
    border-radius: 32px;
    background-color: rgb(8 12 18 / 0.05);
    background-image: linear-gradient(155deg, rgb(255 255 255 / 0.06) 0%, transparent 60%);
    -webkit-backdrop-filter: blur(24px) saturate(1.1);
    backdrop-filter: blur(24px) saturate(1.1);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.18);
    overflow: hidden;
    color: #f0f2f4;
    --ink: #f0f2f4;
    --ink-soft: rgb(240 242 244 / 0.75);
    --ink-2: rgb(240 242 244 / 0.6);
    --shade: 240 242 244;
  }
  .intake__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--grain-fine) 0 0 / 160px;
    opacity: 0.09;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .intake__intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(120px, 14vw, 180px);
    gap: 24px;
    transition: min-height 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .intake__stage.is-open .intake__intro { min-height: 0; }
  .intake__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.125rem, 0.8rem + 1.1vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  /* ---------- Gumb za odprtje ---------- */
  .intake__open {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    align-self: start;
    justify-self: center;
    padding: 13px 24px;
    border: 0;
    border-radius: var(--r-pill);
    background: rgb(250 251 251 / 0.74);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8);
    color: rgb(18 22 28);
    font: inherit;
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: var(--ls-title);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease);
  }
  .intake__open:hover { background: rgb(252 253 253 / 0.92); }
  .intake__open:active { background: rgb(238 242 244 / 0.9); }
  .intake__open:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: var(--r-pill); }
  .intake__open-arrow {
    width: 18px; height: 18px;
    fill: none; stroke: currentColor;
    stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
    transition: transform 400ms var(--ease);
  }

  /* Skrij gumb ko je forma odprta */
  .intake__open-wrap {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .intake__open-wrap > * { overflow: hidden; }
  .intake__stage.is-open .intake__open-wrap {
    grid-template-rows: 0fr;
  }
  .intake__open {
    transition: background-color var(--t-fast) var(--ease), opacity 220ms var(--ease);
  }
  .intake__stage.is-open .intake__open {
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- Collapse animacija ---------- */
  .intake__collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .intake__stage.is-open .intake__collapse {
    grid-template-rows: 1fr;
  }
  .intake__collapse-inner { overflow: hidden; }

  /* ---------- Zapri gumb ---------- */
  .intake__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    margin-bottom: 16px;
    border: 0;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .intake__close:hover { background: rgb(255 255 255 / 0.2); color: var(--ink); }
  .intake__close svg {
    width: 16px; height: 16px;
    fill: none; stroke: currentColor;
    stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }

  /* ---------- Form vsebina ---------- */
  .intake__card {
    display: grid;
    gap: 16px;
    padding-top: 4px;
  }
  .intake__card:focus { outline: none; }

  .intake__card-title {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* ---------- Polja ---------- */
  .intake__fields { display: grid; gap: 12px; }
  .field__label { font-size: 0.8125rem; font-weight: 500; color: var(--ink-soft); }
  .optional { font-weight: 300; color: var(--ink-2); }
  .input {
    width: 100%;
    min-height: 36px;
    padding: 6px 2px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: inset 0 -1px 0 rgb(var(--shade) / 0.34);
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    transition: box-shadow var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }
  textarea.input { min-height: 52px; resize: vertical; }
  .input:hover { background: rgb(255 255 255 / 0.08); }
  .input:focus { outline: none; background: rgb(255 255 255 / 0.14); box-shadow: inset 0 -1.5px 0 var(--ink); }
  .input[aria-invalid='true'] { background: rgb(246 228 225 / 0.3); box-shadow: inset 0 -1.5px 0 var(--danger); }

  /* ---------- Nalaganje ---------- */
  .intake__drop {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 14px 12px;
    border-radius: 14px;
    border: 1px dashed rgb(var(--shade) / 0.3);
    background: rgb(255 255 255 / 0.12);
    text-align: center;
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .intake__drop:hover { background: rgb(255 255 255 / 0.22); border-color: rgb(var(--shade) / 0.42); }
  :global(.drop:focus-within) .intake__drop { outline: 2px solid var(--ink); outline-offset: 3px; }
  :global(.drop.is-over) .intake__drop { background: rgb(255 255 255 / 0.34); border-color: var(--ink-2); }
  .intake__drop-mark { position: relative; width: 14px; height: 14px; margin-bottom: 2px; }
  .intake__drop-mark::before, .intake__drop-mark::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 14px; height: 1.5px; border-radius: 2px; background: var(--ink-2); transform: translateY(-50%);
  }
  .intake__drop-mark::after { transform: translateY(-50%) rotate(90deg); }
  .intake__drop-title { font-weight: 500; font-size: 0.875rem; }
  .intake__drop-text { font-weight: 300; color: var(--ink-soft); font-size: 0.8125rem; }

  /* ---------- Pošlji gumb ---------- */
  .intake__foot { display: grid; gap: 10px; }
  .intake__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--r-pill);
    background: rgb(250 251 251 / 0.74);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 14px 30px -24px rgb(var(--shade) / 0.5);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: var(--ls-title);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease);
  }
  .intake__submit:hover { background: rgb(252 253 253 / 0.92); }
  .intake__submit:active { background: rgb(238 242 244 / 0.9); }
  .intake__submit:focus-visible { border-radius: var(--r-pill); }
  .intake__submit-line { width: 22px; height: 1px; background: currentColor; transform-origin: left; transition: transform var(--t-card) var(--ease); }
  .intake__submit:hover .intake__submit-line { transform: scaleX(1.5); }
  .intake__helper { font-weight: 300; font-size: 0.8rem; line-height: 1.5; color: var(--ink-soft); text-align: center; }

  /* ---------- Pomanjšani globalni elementi znotraj intake ---------- */
  :global(.intake .field__help) { font-size: 0.75rem; color: #f0f2f4 !important; }
  :global(.intake .check) { font-size: 0.8125rem; grid-template-columns: 20px 1fr; gap: 8px; }
  :global(.intake .check input) { width: 20px; height: 20px; }
  :global(.intake .check__box) { width: 20px; height: 20px; }

  /* ---------- Telefon ---------- */
  @media (max-width: 640px) {
    .intake { padding-block: var(--space-7); }
    .intake__stage { padding: 28px 20px 32px; border-radius: 24px; gap: 20px; }
    .intake__title { font-size: clamp(1.25rem, 5.4vw, 1.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intake__collapse { transition: none; }
    .intake__submit-line, .input, .intake__drop { transition: none; }
  }
</style>
