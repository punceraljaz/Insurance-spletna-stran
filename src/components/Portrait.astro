---
/**
 * Pokončen uredniški portret z eno matirano stekleno ploščo.
 *  · fotografija: prop `src` (pot v public/), `alt` (prazen pri začasni sliki)
 *  · steklena plošča: vsebina reže (slot) — zameglitev dejansko zamegli fotografijo pod njo
 * Zamenjava fotografije = sprememba ene poti v content.ts (about.portrait.src).
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  position?: string; // object-position (npr. '50% 30%')
}
const { src, alt, width = 1200, height = 1500, position = '50% 28%' } = Astro.props;
---

<div class="portrait">
  <div class="portrait__frame" data-reveal>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      style={`object-position:${position}`}
    />
  </div>
  {Astro.slots.has('default') && (
    <div class="portrait__glass" data-reveal style="--i:3">
      <slot />
    </div>
  )}
</div>

<style>
  .portrait { position: relative; isolation: isolate; }

  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: #e7ebec; /* rezerviran prostor — brez poskakovanja */
  }
  .portrait__frame img { width: 100%; height: 100%; object-fit: cover; }

  /* Ena plošča: nevtralno sivo matirano steklo, mehki robovi, fino zrno.
     Prekriva spodnji del (ramena), obraz ostane viden; na namizju sega čez desni rob fotografije. */
  .portrait__glass {
    position: absolute;
    left: 8%;
    right: -14%;
    bottom: 7%;
    isolation: isolate;
    padding: clamp(22px, 2.6vw, 36px) clamp(24px, 3vw, 40px);
    border-radius: 22px;
    overflow: hidden;
    color: var(--ink);
    background-color: rgb(226 230 232 / 0.3);
    background-image: linear-gradient(150deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.04) 60%, rgb(200 208 214 / 0.12));
    -webkit-backdrop-filter: blur(22px) saturate(1.05);
    backdrop-filter: blur(22px) saturate(1.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3), inset 0 1px 0 rgb(255 255 255 / 0.4);
  }
  .portrait__glass::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--grain-fine) 0 0 / 160px;
    opacity: 0.1;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Gibanje: portret se dvigne za ~16px, steklo sledi nekoliko kasneje */
  :global(.js) .portrait [data-reveal] { transform: translateY(16px); }
  :global(.js) .portrait [data-reveal].is-in { transform: none; }
  :global(.js) .portrait__glass[data-reveal] { transition-delay: 260ms; }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .portrait__glass { background: rgb(236 239 240 / 0.92); }
  }

  @media (max-width: 1100px) {
    .portrait__glass { right: -8%; }
  }
  @media (max-width: 900px) {
    .portrait__frame { aspect-ratio: 4 / 4.6; }
    .portrait__glass { left: 5%; right: 5%; bottom: 5%; }
  }
</style>
