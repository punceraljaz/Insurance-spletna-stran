---
import { contact, site, audiences, type Audience } from '../data/content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Partners from './Partners.astro';
interface Props { audience: Audience }
const { audience } = Astro.props;
const other: Audience = audience === 'podjetja' ? 'posamezniki' : 'podjetja';
const legal = [{ label: 'Partnerji', href: '#partnerji' }, ...contact.legal];
const year = new Date().getFullYear();
---

<footer id="kontakt" class="shell footer" data-chapter="dusk" aria-labelledby="footer-title">
  <div class="dusk">
    <Partners />

    <div class="contact-block" data-reveal>
      <h2 id="footer-title" class="contact-card__title">{contact.title}</h2>

      <div class="contact-entries">
        <div class="contact-entry">
          <a class="contact-entry__value contact-entry__link" href={site.phoneHref}>{site.phoneDisplay}</a>
          <span class="contact-entry__sub">{site.hours}</span>
          <a class="contact-entry__value contact-entry__link" href={`mailto:${site.email}`}>{site.email}</a>
        </div>

        <div class="contact-entry">
          <a class="contact-entry__value contact-entry__link" href="#rezervacija" data-open-tab="rezervacija">Spletni koledar →</a>
        </div>
      </div>
    </div>

    <div class="dusk__bottom">
      <p class="dusk__brand">
        <Logo size={44} class="dusk__mark" />
        <span class="dusk__brand-sub">{site.brandSub}</span>
      </p>
      <nav aria-label="Pravne informacije">
        <ul class="legal">
          {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <p class="dusk__fine">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: clamp(20px, 3vw, 36px);
    padding-top: clamp(120px, 18vw, 280px);
    background: linear-gradient(to bottom, rgb(255 255 255) 0%, rgb(230 234 238) 6%, rgb(190 198 210) 14%, rgb(148 162 178) 24%, rgb(108 122 140) 36%, rgb(76 90 108) 50%, rgb(55 66 82) 66%, rgb(38 46 58) 100%);
    max-width: none;
    margin-inline: 0;
  }
  @media (max-width: 640px) {
    .footer { padding-top: clamp(160px, 36svh, 260px); }
  }
  .dusk { position: relative; isolation: isolate; }
  .contact-block {
    padding-block: clamp(72px, 10vw, 120px);
  }
  .contact-entries {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.5vw, 32px);
    margin-top: clamp(28px, 3.5vw, 44px);
  }
  .contact-card__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 0.8rem + 2.2vw, 2.25rem);
    letter-spacing: -0.01em;
    color: rgb(255 255 255);
    margin: 0 0 10px;
  }
  .contact-entry { display: grid; gap: 4px; align-content: start; }
  .contact-entry__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255);
    margin-bottom: 2px;
  }
  .contact-entry__value {
    font-size: 1rem;
    font-weight: 500;
    color: rgb(255 255 255);
    line-height: 1.3;
  }
  .contact-entry__sub {
    font-size: 0.875rem;
    color: rgb(255 255 255);
  }
  .contact-entry__link {
    text-decoration: none;
    color: rgb(255 255 255);
    transition: opacity var(--t-fast) var(--ease);
  }
  .contact-entry__link:hover { opacity: 0.6; }
  /* Preklop poti — samo gumb, brez naslova; spodnji padding = razmik do Partners */
  .dusk__switch {
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .dusk__bottom {
    display: grid;
    gap: 10px;
    padding-top: clamp(28px, 3.5vw, 40px);
    text-align: center;
  }
  .dusk__brand {
    display: flex; align-items: center; justify-content: center; gap: 4px;
    color: rgb(255 255 255);
  }
  .dusk__brand-sub {
    font-size: 0.75rem; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase;
  }
  :global(.dusk__mark) { flex: none; mix-blend-mode: normal !important; filter: brightness(0) invert(1); opacity: 0.9; }
  .legal {
    list-style: none; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 0;
  }
  .legal li + li::before {
    content: '·';
    padding-inline: 6px;
    color: rgb(255 255 255);
    font-size: 0.75rem;
  }
  .legal a {
    font-size: 0.8125rem; text-decoration: none; color: rgb(255 255 255);
    padding-block: 4px;
  }
  .legal a:hover { opacity: 0.7; }
  .dusk__fine { font-size: 0.75rem; color: rgb(255 255 255); }

  @media (max-width: 480px) {
    .legal { margin-inline: -10px; }
    .dusk__switch .btn { width: 100%; justify-content: space-between; }
    .contact-block { padding-block: clamp(36px, 8svh, 56px); }
  }
</style>
