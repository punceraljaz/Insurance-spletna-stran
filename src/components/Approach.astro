---
/**
 * Posamezniki: zavarovalno posredništvo kot način dela pri vseh področjih (ni šesta kategorija).
 * Štiri načela v odprti mreži s tankimi črtami. Pregled police in posvet sta v sekcijah #pregled in #rezervacija.
 */
import { individualApproach as a } from '../data/content';
---

<section id="nacin-dela" class="chapter shell approach" data-chapter="warm" aria-labelledby="appr-title">
  <div class="approach__grid">
    <header class="approach__head">
      <p class="micro micro--rule" data-reveal>{a.label}</p>
      <h2 id="appr-title" class="h2" data-reveal style="--i:1">{a.title} <em class="serif">{a.titleAccent}</em></h2>
      <p class="approach__intro" data-reveal style="--i:2">{a.intro}</p>
    </header>

    <ol class="approach__points">
      {a.points.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class="approach__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="approach__k">{p.k}</h3>
          <p class="approach__v">{p.v}</p>
        </li>
      ))}
    </ol>
  </div>

</section>

<style>
  .approach { padding-top: clamp(96px, 11vw, 160px); }
  .approach__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .approach__head { display: grid; gap: 18px; }
  .approach__intro { font-weight: 300; font-size: var(--fs-lead); line-height: 1.6; color: var(--ink-soft); max-width: 36ch; }

  .approach__points {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 3vw, 48px);
  }
  .approach__points li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 22px 0 26px;
    border-top: 1px solid rgb(var(--shade) / 0.14);
  }
  .approach__n { font-size: var(--fs-micro); font-weight: 500; letter-spacing: 0.12em; color: var(--ink-mute); font-variant-numeric: tabular-nums; }
  .approach__k { font-size: 1.0625rem; line-height: 1.35; }
  .approach__v { font-weight: 300; color: var(--ink-soft); line-height: 1.5; }

  @media (max-width: 960px) {
    .approach__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .approach__points { grid-template-columns: 1fr; }
  }
</style>
