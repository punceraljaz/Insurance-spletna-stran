---
/**
 * Storitev kot vrstica v odprtem področju (namesto kartice).
 * Viden je naslov in en stavek; razlaga in »Primerno ob« sta za gumbom (postopno razkrivanje).
 */
import type { Service } from '../data/content';

interface Props { service: Service; level?: 3 | 4 }
const { service: s, level = 3 } = Astro.props;
const H = level === 3 ? 'h3' : 'h4';
const moreId = `st-${s.id}`;
---

<div class="srow" data-expandable data-provisional={s.provisional ? 'true' : undefined}>
  <H class="srow__h">
    <button class="srow__btn" type="button" aria-expanded="false" aria-controls={moreId} data-toggle>
      <span class="srow__title">{s.title}</span>
      <span class="srow__short">{s.short}</span>
      <span class="srow__mark" aria-hidden="true"></span>
    </button>
  </H>
  <div class="collapse" id={moreId} data-open="false">
    <div class="collapse__inner">
      <div class="srow__more">
        <p>{s.text}</p>
        <p class="srow__label">Primerno ob</p>
        <ul class="srow__list">
          {s.situations.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .srow { border-top: 1px solid rgb(var(--shade) / 0.12); }
  .srow__h { font: inherit; letter-spacing: inherit; text-transform: none; }

  .srow__btn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: center;
    width: 100%;
    min-height: 72px;
    padding: 18px 4px;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }
  .srow__title {
    grid-column: 1;
    font-size: 1.0625rem;
    font-weight: var(--w-title);
    letter-spacing: var(--ls-title);
    line-height: 1.35;
  }
  .srow__short {
    grid-column: 1;
    font-weight: 300;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .srow__mark {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    width: 16px;
    height: 16px;
    opacity: 0.7;
    transition: opacity var(--t-fast) var(--ease);
  }
  .srow__btn:hover .srow__mark { opacity: 1; }
  .srow__mark::before, .srow__mark::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 16px; height: 1.5px; border-radius: 2px;
    background: var(--ink); transform: translateY(-50%); transition: transform var(--t-card) var(--ease);
  }
  .srow__mark::after { transform: translateY(-50%) rotate(90deg); }
  .srow__btn[aria-expanded='true'] .srow__mark::after { transform: translateY(-50%) rotate(0deg); }
  .srow__btn:focus-visible { outline-offset: -2px; border-radius: 10px; }

  .srow__more {
    display: grid;
    gap: 10px;
    padding: 0 4px 22px;
    max-width: 58ch;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .srow__label { margin-top: 4px; font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .srow__list { list-style: none; padding: 0; display: grid; gap: 6px; }
  .srow__list li { position: relative; padding-left: 18px; }
  .srow__list li::before {
    content: ''; position: absolute; left: 2px; top: 0.78em;
    width: 8px; height: 1px; background: var(--ink-mute);
  }
</style>
